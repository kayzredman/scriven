# Where the API server sends audit events: scriven watch, on the Docker host.
# __TARGET__ is replaced with the scriven target id (the cluster name).
apiVersion: v1
kind: Config
clusters:
  - name: scriven
    cluster:
      server: http://host.k3d.internal:8099/audit/__TARGET__
users:
  - name: scriven
contexts:
  - name: scriven
    context:
      cluster: scriven
      user: scriven
current-context: scriven
