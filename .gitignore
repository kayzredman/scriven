# Lab secrets and generated kubeconfigs
scriven-lab/.env
scriven-lab/.lab/

# Build output
/bin/
/dist/
*.exe

# Terraform working files (captures are verified in a temp dir, never here)
.terraform/
*.tfstate
*.tfstate.*
*.tfplan

# Local Scriven config used against the lab
/scriven.yaml
scriven-lab/audit/.webhook-*

# Lab sample Terraform lock files: the provider version floats with the lab
scriven-lab/sample-aws/**/.terraform.lock.hcl
